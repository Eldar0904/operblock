# Clerk Authentication (frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Authentication (backend)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://operblock:operblock@localhost:5432/operblock

# Cloudflare R2 (task attachments) — keep private; never expose as VITE_*
R2_ACCOUNT_ID=4adc57328c5c6bb48b3648613b7503a0
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=operblock-files
R2_ENDPOINT=https://4adc57328c5c6bb48b3648613b7503a0.r2.cloudflarestorage.com

# App
APP_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# Production (Render/Railway): set NODE_ENV=production
# APP_URL=https://your-app.onrender.com  OR  https://your-app.up.railway.app
# VITE_CLERK_PUBLISHABLE_KEY must be set at build time on the host
# PORT is set automatically by Render/Railway — leave unset in production
# Also set the five R2_* vars above so task file uploads work